<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AssemblyName>floratool</AssemblyName>
		<PackageId>floratool</PackageId>
		<LangVersion>14</LangVersion>
		<NoWarn>1701;1702;1591;</NoWarn>
		<WarningsAsErrors></WarningsAsErrors>
		<TreatWarningsAsErrors>False</TreatWarningsAsErrors>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<DefineConstants>SANDBOX</DefineConstants>
		<AllowUnsafeBlocks>False</AllowUnsafeBlocks>
		<OutputPath>E:/SteamLibrary/steamapps/common/sbox/.vs/output/</OutputPath>
		<DocumentationFile>E:/SteamLibrary/steamapps/common/sbox/.vs/output/floratool.xml</DocumentationFile>
		<RootNamespace>Sandbox</RootNamespace>
		<Nullable>disable</Nullable>
		<SandboxHostMigration>true</SandboxHostMigration>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Sandbox.Internal.GlobalGameNamespace" Static="true" />
		<Using Include="Microsoft.AspNetCore.Components" />
		<Using Include="Microsoft.AspNetCore.Components.Rendering" />
	</ItemGroup>

	<ItemGroup>
		<Analyzer Include="E:/SteamLibrary/steamapps/common/sbox/bin/managed/Sandbox.CodeUpgrader.dll"/> 
		<Analyzer Include="E:/SteamLibrary/steamapps/common/sbox/bin/managed/Sandbox.Generator.dll"/> 
		<CompilerVisibleProperty Include="SandboxHostMigration" />
		<Reference Include="E:/SteamLibrary/steamapps/common/sbox/bin/managed/Sandbox.System.dll"/> 
		<Reference Include="E:/SteamLibrary/steamapps/common/sbox/bin/managed/Sandbox.Engine.dll"/> 
		<Reference Include="E:/SteamLibrary/steamapps/common/sbox/bin/managed/Sandbox.Filesystem.dll"/> 
		<Reference Include="E:/SteamLibrary/steamapps/common/sbox/bin/managed/Sandbox.Reflection.dll"/> 
		<Reference Include="E:/SteamLibrary/steamapps/common/sbox/bin/managed/Sandbox.Mounting.dll"/> 
		<Reference Include="E:/SteamLibrary/steamapps/common/sbox/bin/managed/Microsoft.AspNetCore.Components.dll"/> 
	</ItemGroup>

</Project>
